# Anthropic API key. Without it, Hospitality runs in Demo Mode using
# pre-generated fixtures so the app remains fully explorable offline.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium

# Public origin used for link previews and robots.txt, e.g.
# https://hospitality.example.com. Not needed on Vercel.
# NEXT_PUBLIC_SITE_URL=
