# Anthropic API key. Without it, Hospitality runs in Demo Mode using
# pre-generated fixtures so the app remains fully explorable offline.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium

# Contact for privacy requests and grievances, shown on /privacy. India's
# DPDP Act requires one to be published — set it before launch.
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@yourdomain.in

# Public origin used for link previews and robots.txt, e.g.
# https://hospitality.example.com. Not needed on Vercel.
# NEXT_PUBLIC_SITE_URL=

# Rate limiting (see README → Rate limiting). In-memory per instance by
# default; set these for shared counters on Vercel or multi-instance hosts.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_IP_HEADER=x-forwarded-for
# RATE_LIMIT_GLOBAL_PER_HOUR=600
